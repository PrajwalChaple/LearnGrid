rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── User Profiles ──────────────────────────────────────────
    // Any authenticated user can READ any user profile (needed for recipient queries).
    // Users can only WRITE their own profile document.
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // ─── Helper: check if the user's profile matches the document's class fields ──
    function isClassMatch(docData) {
      let userDoc = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return userDoc.institutionName == docData.institutionName
          && userDoc.roleType == docData.roleType
          && (
            (userDoc.roleType == 'college'
              && userDoc.department == docData.department
              && userDoc.year == docData.year)
            ||
            (userDoc.roleType == 'school'
              && userDoc.standard == docData.standard
              && userDoc.section == docData.section)
          );
    }

    // ─── Notes ──────────────────────────────────────────────────
    match /notes/{noteId} {
      allow read: if request.auth != null && isClassMatch(resource.data);
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid
                    && isClassMatch(request.resource.data);
      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;
      allow update: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    // ─── Assignments ────────────────────────────────────────────
    match /assignments/{assignmentId} {
      allow read: if request.auth != null && isClassMatch(resource.data);
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid
                    && isClassMatch(request.resource.data);
      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;
      allow update: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    // ─── Announcements ─────────────────────────────────────────
    match /announcements/{announcementId} {
      allow read: if request.auth != null && isClassMatch(resource.data);
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid
                    && isClassMatch(request.resource.data);
      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;
      allow update: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    // ─── Notifications ─────────────────────────────────────────
    // Authenticated users can create notifications.
    // Users can read notifications they sent.
    match /notifications/{notificationId} {
      allow create: if request.auth != null;
      allow read: if request.auth != null
                   && resource.data.senderId == request.auth.uid;
      allow update, delete: if false;
    }
  }
}
